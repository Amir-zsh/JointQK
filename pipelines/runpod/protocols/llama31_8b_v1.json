{
  "protocol": "llama31_8b_v1",
  "comment": [
    "Llama-3.1-8B-Instruct accuracy grid, mirroring qwen3_8b_v1 so the two are",
    "comparable knob-for-knob. run_cell.sh resolves every serve/client knob from",
    "here; the protocol name + this file's sha256 land in each cell's",
    "provenance.json, so two cells are comparable iff their protocol hashes match.",
    "",
    "SAMPLING IS PER-MODEL AND MUST NOT BE COPIED FROM THE QWEN PROTOCOL. The",
    "values below are Llama-3.1-8B-Instruct's own generation_config.json defaults:",
    "T=0.6 / top_p=0.9 / no top_k (top_k=-1 disables it in SGLang). Qwen3 uses",
    "top_p=0.95 / top_k=20; gpt-oss uses T=1.0 / top_p=1.0. Applying one model's",
    "values to another is the same class of error as the legacy T=1.0/top_k=40",
    "GLM-branch protocol that invalidated an earlier Qwen grid.",
    "",
    "Llama-3.1 is NOT a thinking model: caps are 2048-4096, not 32768. NIAH is",
    "greedy (temperature 0.0, 1 sample) matching the shipped grid in",
    "artifacts/oscar_llama31_8b/grid/, so cells here are directly comparable to it.",
    "",
    "Rotation provenance: `rotations/` is the 50-prompt v1 that the shipped grid",
    "used. `rotations_gpqa198/` (198 prompts, corpus-matched to the codebook) was",
    "built later and A/B'd on 2026-07-27: NIAH-8K moved -0.28 for both int2 and",
    "vq2, i.e. nothing (artifacts/oscar_llama31_8b/rotcheck/). Keeping the 50-prompt",
    "rotation preserves continuity with the published numbers."
  ],
  "model": "meta-llama/Llama-3.1-8B-Instruct",
  "tp": 1,
  "ctx": 73728,
  "mem_frac": 0.85,
  "max_tokens_pool": "auto",
  "chunked_prefill_size": 4096,
  "exact_chunked_prefill": false,
  "cuda_graph_max_bs": 8,
  "rot_dir": "artifacts/oscar_llama31_8b/rotations",
  "vq_codebook": "artifacts/oscar_llama31_8b/vqa_llama31_8b_G4_strat_flat_ptn_gpqacc128k_fp8.pt",
  "arms": {
    "bf16":       { "mode_flag": "--bf16", "max_reqs": 8, "kv_splits": 8 },
    "oscar_int2": { "mode_flag": "",       "max_reqs": 4, "kv_splits": 8,  "scale_dtype": "float32" },
    "vq2":        { "mode_flag": "--vq2",  "max_reqs": 4, "kv_splits": 48, "scale_dtype": "bfloat16" },
    "quarot":     { "mode_flag": "--int2plain", "max_reqs": 4, "kv_splits": 8,
                     "hadamard_order": 128, "k_clip_ratio": 1.0, "v_clip_ratio": 1.0 },
    "naive_int2": { "mode_flag": "--int2plain", "max_reqs": 4, "kv_splits": 8,
                     "hadamard_order": 16, "no_hadamard": 1,
                     "k_clip_ratio": 1.0, "v_clip_ratio": 1.0 },
    "turboquant_int2":  { "mode_flag": "--int2plain", "max_reqs": 4, "kv_splits": 8,
                     "hadamard_order": 128, "k_clip_ratio": 1.0, "v_clip_ratio": 1.0,
                     "lloyd_max": 1 },
    "turboquant_k3v3":  { "mode_flag": "--bf16", "max_reqs": 4, "kv_splits": 8,
                     "simquant_bundle": "artifacts/simquant/simquant_turboquant_d128_L36_k3v3.pt" }
  },
  "tasks": {
    "gpqa":       { "rows": "artifacts/prompt_rows/gpqa_diamond_llama.jsonl",   "samples": 5, "temperature": 0.6, "top_p": 0.9, "top_k": -1 },
    "aime25":     { "rows": "artifacts/prompt_rows/aime25_llama.jsonl",         "samples": 5, "temperature": 0.6, "top_p": 0.9, "top_k": -1 },
    "math500":    { "rows": "artifacts/prompt_rows/math500_llama.jsonl",        "samples": 5, "temperature": 0.6, "top_p": 0.9, "top_k": -1 },
    "humaneval":  { "rows": "artifacts/prompt_rows_code/humaneval_llama.jsonl", "samples": 5, "temperature": 0.6, "top_p": 0.9, "top_k": -1 },
    "lcb":        { "rows": "artifacts/prompt_rows_code/lcb_v6_sub256_llama.jsonl", "samples": 5, "temperature": 0.6, "top_p": 0.9, "top_k": -1 },
    "niah_8192":  { "rows": "artifacts/prompt_rows/niah_8192_llama.jsonl",  "samples": 1, "temperature": 0.0 },
    "niah_16384": { "rows": "artifacts/prompt_rows/niah_16384_llama.jsonl", "samples": 1, "temperature": 0.0 },
    "niah_32768": { "rows": "artifacts/prompt_rows/niah_32768_llama.jsonl", "samples": 1, "temperature": 0.0 },
    "niah_65536": { "rows": "artifacts/prompt_rows/niah_65536_llama.jsonl", "samples": 1, "temperature": 0.0 },
    "niah_smoke": { "rows": "artifacts/prompt_rows/niah_8192_llama.jsonl",  "samples": 1, "temperature": 0.0, "limit_rows": 24 }
  }
}
