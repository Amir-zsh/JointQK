{
  "protocol": "llama31_8b_v1_ctx131k",
  "comment": [
    "Same grid as llama31_8b_v1.json (see that file for the full arm/sampling",
    "rationale) with ctx bumped past 131072 to add the 128K-length NIAH cell --",
    "mirrors gptoss20b_mxfp4_v1_ctx131k.json's split (a separate protocol file,",
    "not an in-place ctx edit, per protocol discipline: changing any knob is a",
    "new version, and two cells are comparable iff their protocol hashes match).",
    "",
    "niah_131072 corpus: generated via third_party/samuel_vq/gen_niah.py",
    "--model meta-llama/Llama-3.1-8B-Instruct --ctx 131072 --n 100 --seed 0",
    "(matching the existing niah_8192/16384/32768/65536_llama.jsonl convention",
    "exactly -- same n/seed, same 8-subtask RULER-NIAH suite), converted to",
    "artifacts/niah_bench/131072/test.parquet, then exported via",
    "pipelines/eval/export_prompt_rows.py --dataset niah --data-dir 131072.",
    "Greedy (temperature 0.0, 1 sample), matching every other Llama NIAH cell --",
    "NOT gpt-oss's 3-seed convention, which is that protocol's own explicit",
    "choice, not a house default.",
    "",
    "ctx=135168 = 131072 + 4096 headroom, same margin gpt-oss's ctx131k variant",
    "uses (the niah rows' own max_new_tokens is only 128, so this is generous,",
    "not tight)."
  ],
  "model": "meta-llama/Llama-3.1-8B-Instruct",
  "tp": 1,
  "ctx": 135168,
  "mem_frac": 0.85,
  "max_tokens_pool": "auto",
  "chunked_prefill_size": 4096,
  "exact_chunked_prefill": false,
  "cuda_graph_max_bs": 8,
  "rot_dir": "artifacts/oscar_llama31_8b/rotations",
  "vq_codebook": "artifacts/oscar_llama31_8b/vqa_llama31_8b_G4_strat_flat_ptn_gpqacc128k_fp8.pt",
  "arms": {
    "bf16":       { "mode_flag": "--bf16", "max_reqs": 8, "kv_splits": 8 },
    "oscar_int2": { "mode_flag": "",       "max_reqs": 4, "kv_splits": 8,  "scale_dtype": "float32" },
    "vq2":        { "mode_flag": "--vq2",  "max_reqs": 4, "kv_splits": 48, "scale_dtype": "bfloat16" },
    "quarot":     { "mode_flag": "--int2plain", "max_reqs": 4, "kv_splits": 8,
                     "hadamard_order": 128, "k_clip_ratio": 1.0, "v_clip_ratio": 1.0 },
    "naive_int2": { "mode_flag": "--int2plain", "max_reqs": 4, "kv_splits": 8,
                     "hadamard_order": 16, "no_hadamard": 1,
                     "k_clip_ratio": 1.0, "v_clip_ratio": 1.0 },
    "turboquant_int2":  { "mode_flag": "--int2plain", "max_reqs": 4, "kv_splits": 8,
                     "hadamard_order": 128, "k_clip_ratio": 1.0, "v_clip_ratio": 1.0,
                     "lloyd_max": 1 },
    "turboquant_k3v3":  { "mode_flag": "--bf16", "max_reqs": 4, "kv_splits": 8,
                     "simquant_bundle": "artifacts/simquant/simquant_turboquant_d128_L36_k3v3.pt" }
  },
  "tasks": {
    "niah_131072_smoke": { "rows": "artifacts/prompt_rows/niah_131072_llama.jsonl", "samples": 1, "temperature": 0.0, "limit_rows": 24 },
    "niah_131072":        { "rows": "artifacts/prompt_rows/niah_131072_llama.jsonl", "samples": 1, "temperature": 0.0 },
    "niah_131072_tqk3v3_remainder": { "rows": "artifacts/prompt_rows/niah_131072_llama_tqk3v3_remainder.jsonl", "samples": 1, "temperature": 0.0 },
    "niah_131072_bf16_remainder":   { "rows": "artifacts/prompt_rows/niah_131072_llama_bf16_remainder.jsonl",   "samples": 1, "temperature": 0.0 },
    "niah_131072_oscar_int2_remainder": { "rows": "artifacts/prompt_rows/niah_131072_llama_oscar_int2_remainder.jsonl", "samples": 1, "temperature": 0.0 },
    "niah_131072_bf16_head":      { "rows": "artifacts/prompt_rows/niah_131072_llama_bf16_head.jsonl",      "samples": 1, "temperature": 0.0 },
    "niah_131072_tqk3v3_head":    { "rows": "artifacts/prompt_rows/niah_131072_llama_tqk3v3_head.jsonl",    "samples": 1, "temperature": 0.0 }
  }
}
