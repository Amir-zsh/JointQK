+# LOCAL PATCH (not upstream kvpress) -- see fixes_to_apply.md. Reference
+# answers are plain digit strings with no separators; models write large
+# numbers with thousands-separators ("4,484,859", or "1 681 570" in
+# markdown-table output -- observed both from the same model in the same
+# response batch), which breaks the exact substring match below even though
+# the answer is correct. Only strips a separator directly between two
+# digits, so "12, 34" (a genuine two-item list, space after the comma) is
+# untouched -- only comma/no-break-space with no surrounding word-space
+# would merge, which no observed model output does for genuine list items.
+_SEP_IN_NUMBER = re.compile(r"(?<=\d)[,\u00a0\u202f](?=\d)")
+
+
+def polish(text: str) -> str:
+    return _SEP_IN_NUMBER.sub("", text)
+
 
