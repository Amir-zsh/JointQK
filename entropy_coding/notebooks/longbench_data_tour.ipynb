    "def pick_representative_heads(shannon_mat: torch.Tensor, n: int = 4, layer_offset: int = 0):\n",
    "    \"\"\"Pick n (layer, head) indices evenly spanning the Shannon-rank range.\n",
    "\n",
    "    layer_offset is added back to the returned layer indices so callers can pass a\n",
    "    sliced Shannon matrix and still get absolute layer IDs in the labels.\n",
    "    \"\"\"\n",
    "    flat = shannon_mat.flatten()\n",
    "    order = flat.argsort()\n",
    "    picks = order[torch.linspace(0, len(order) - 1, n).long()].tolist()\n",
    "    _, H = shannon_mat.shape\n",
    "    return [(i // H + layer_offset, i % H) for i in picks], [float(flat[i]) for i in picks]\n",
    "\n",
    "\n",
    "fig, axes = plt.subplots(1, len(tensor_names), figsize=(15, 4.5), sharey=True)\n",
    "for ax, name in zip(axes, tensor_names):\n",
    "    cov = pooled[name][1][START_LAYER:].float()\n",
    "    eigvals = torch.linalg.eigvalsh(cov).clamp_min(1e-30)   # ascending\n",
    "    eigvals_desc = eigvals.flip(-1)                         # descending\n",
    "    shannon_sub = measures[name]['shannon'][START_LAYER:]\n",
    "    picks, ranks = pick_representative_heads(shannon_sub, n=4, layer_offset=START_LAYER)\n",
    "    for (l_abs, h), r in zip(picks, ranks):\n",
    "        spec = eigvals_desc[l_abs - START_LAYER, h]\n",
    "        spec_norm = spec / spec[0]                          # normalize to lambda_max = 1\n",
    "        ax.plot(spec_norm.log10().numpy(), label=f'L{l_abs:02d} H{h:02d}  shannon={r:.1f}')\n",
    "    ax.set_title(f'{name}: normalized log-spectrum')\n",
    "    ax.set_xlabel('eigenvalue index (descending)')\n",
    "    ax.grid(alpha=0.3)\n",
    "    ax.legend(fontsize=8)\n",
    "axes[0].set_ylabel(r'$\\log_{10}(\\lambda_i / \\lambda_{\\max})$')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
