    "DATA_DIR = Path('data')   # where datasets are downloaded to / read from\n",
    "DATASET  = 'small'         # 'small' (~7 GB, 3 examples) or 'full' (~57 GB, 24 examples)\n",
    "\n",
    "SPECS = {\n",
    "    'small': {\n",
    "        'dirname': 'query_stats_longbench_under4k_small',\n",
