   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Layer 0 is structurally different from the rest of the stack; see section 6 intro.\n",
    "# All plots/summaries below skip layers [0, START_LAYER). Set START_LAYER = 0 to include layer 0.\n",
    "START_LAYER = 1\n",
    "\n",
    "\n",
    "def rank_measures(cov: torch.Tensor, eps: float = 1e-30) -> dict[str, torch.Tensor]:\n",
    "    \"\"\"Rank-like summaries of a batch of covariance matrices.\n",
    "\n",
    "    cov : Tensor of shape (L, H, d, d), symmetric PSD.\n",
    "    Returns six (L, H) tensors keyed by measure name.\n",
    "    \"\"\"\n",
    "    eigvals = torch.linalg.eigvalsh(cov.float()).clamp_min(0)   # (L, H, d), ascending\n",
    "    sums   = eigvals.sum(-1)                                    # (L, H)\n",
    "    sqsums = eigvals.pow(2).sum(-1)                             # (L, H)\n",
    "    maxes  = eigvals.amax(-1)                                   # (L, H)\n",
    "\n",
    "    stable        = sums / maxes.clamp_min(eps)\n",
    "    participation = sums.pow(2) / sqsums.clamp_min(eps)\n",
    "    p             = eigvals / sums.unsqueeze(-1).clamp_min(eps)\n",
    "    shannon       = torch.exp(-(p * p.clamp_min(eps).log()).sum(-1))\n",
    "\n",
    "    eigvals_desc = eigvals.flip(-1)                             # descending\n",
    "    cum = eigvals_desc.cumsum(-1) / sums.unsqueeze(-1).clamp_min(eps)   # (L, H, d)\n",
    "\n",
    "    def rank_at(threshold: float) -> torch.Tensor:\n",
    "        return (cum >= threshold).int().argmax(-1) + 1          # (L, H)\n",
    "\n",
    "    return {\n",
    "        'shannon':       shannon,\n",
