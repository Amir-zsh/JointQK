    "        'approx_size': '~57 GB',\n",
    "    },\n",
    "}\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "spec = SPECS[DATASET]\n",
    "DATA_DIR.mkdir(parents=True, exist_ok=True)\n",
    "DATA_ROOT = DATA_DIR / spec['dirname']\n",
